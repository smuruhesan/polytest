# .github/workflows/upload-file.yml
name: Upload File to GitHub

on:
  push:
    branches:
      - main

jobs:
  upload-file:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout the repository
        uses: actions/checkout@v3

      - name: Set up Git configuration
        run: |
          git config --global user.name "github-actions"
          git config --global user.email "github-actions@github.com"

      - name: Create or update file
        run: |
          echo "This is a sample file" > sample-file.txt

      - name: Commit and push file
        env:
          GITHUB_TOKEN: ghp_mJBHCEuO×X0A2g7wNOVHtL0450Hq®14FgrKh  # Use GitHub-provided token
        run: |
          git add sample-file.txt
          git commit -m "Add sample file"
          git push
